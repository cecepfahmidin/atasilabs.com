// Prisma schema for atasilabs.com Studio with Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  NEW
  READ
  ARCHIVED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum UserRole {
  ADMIN
  DEVELOPER
}

model Lead {
  id          String   @id @default(uuid())
  name        String
  email       String
  company     String?
  serviceType String?
  budget      String?
  message     String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
}

model Portfolio {
  id              String   @id @default(uuid())
  title           String
  description     String
  fullDescription String?
  category        String   @default("Full-Stack")
  imageUrl        String
  techStack       String[]
  liveUrl         String?
  repoUrl         String?
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClientProject {
  id             String   @id @default(uuid())
  clientName     String
  clientEmail    String
  clientPhone    String?
  clientCompany  String?
  title          String
  description    String
  deadline       String
  budget         Float
  progress       Int      @default(0)
  status         String   @default("PLANNING")
  ipwStage       String?  @default("STAGE_1_DISCOVERY")
  tierNumber     Int?     @default(1)
  freelancerName String?
  freelancerFee  Float?
  isArchived     Boolean? @default(false)
  payments       Json?
  totalPaid      Float?   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PricingTier {
  id             String   @id @default(uuid())
  tierNumber     Int
  name           String
  tagline        String
  price          Float
  originalPrice  Float?
  priceBilling   String
  popular        Boolean  @default(false)
  highlightBadge String?
  deliveryTime   String
  revisionCount  String
  features       String[]
  specs          Json?
  idealFor       String
  ctaText        String
  updatedAt      DateTime @updatedAt
}

model ServiceItem {
  id          String   @id @default(uuid())
  title       String
  subtitle    String
  description String
  features    String[]
  iconName    String
  techTags    String[]
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  role       String   @default("ADMIN")
  password   String?
  phone      String?
  company    String?
  status     String   @default("ACTIVE")
  avatarUrl  String?
  bio        String?
  tagline    String?
  titleBadge String?
  roleTitle  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String
  company     String?
  quote       String
  avatarUrl   String?
  bgColor     String?  @default("#161616")
  accentColor String   @default("#FFD600")
  featured    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model CompanyContact {
  id           String   @id @default("singleton-contact")
  companyName  String
  subtitle     String
  description  String
  email        String
  phone        String
  whatsapp     String
  whatsappRaw  String
  address      String
  workingHours String
  facebookUrl  String
  instagramUrl String
  ndaNotice    String
  updatedAt    DateTime @default(now()) @updatedAt
}

model RbacMatrix {
  id          String   @id @default("singleton-rbac")
  permissions Json
  updatedAt   DateTime @default(now()) @updatedAt
}

model HppData {
  id          String   @id @default("singleton-hpp")
  matrix      Json
  allocations Json
  updatedAt   DateTime @default(now()) @updatedAt
}

model CustomDocument {
  id          String   @id @default(uuid())
  projectId   String   @unique
  data        Json
  updatedAt   DateTime @default(now()) @updatedAt
}

